<section class="section">
    <form method="get" class="form-busca">
        <div class="col-md-12">
            <div class="row">
                <div class="form-group">
                    <div class="col-md-3">
                        <label for="select2-id_anteprojeto-container">Anteprojeto</label>
                    </div>
                    <div class="col-md-9 r_col">
                        <select name="anteprojeto" id="id_anteprojeto" class="custom-select" style="width: 100%">
                            <option value=""></option>
                            {{#anteprojetos}}
                                <option value="{{valor}}" {{selected}}>{{selecao}}</option>
                            {{/anteprojetos}}
                        </select>
                    </div>
                </div>
                <div class="d-flex align-items-center mt-3">
                    <div class="col-md-12">
                        <button type="submit" class="btn" name="listar" data-toggle="tooltip" data-placement="top" title="Buscar">
                            <i class="flaticon-magnifying-glass" id="yui_3_17_2_1_1647205690370_21" style="font-weight: 600;font-size: 15px;"></i>
                        </button>
                        <a data-toggle="tooltip" data-placement="top" title="Limpar o campo do Filtro" href="{{{ config.wwwroot }}}/blocks/eva_barema_afastamento/avaliacao_lista.php" class="btn">
                            <i class="flaticon-delete-button" id="yui_3_17_2_1_1647205690370_21" style="font-weight: 400;font-size: 15px;"></i> Limpar Filtro
                        </a>
                        <button type="submit" name="relatorio" class="btn" href="#" data-toggle="tooltip" data-placement="top" title="Imprimir Relatório em PDF"
                            onclick="open('avaliacao_lista.php{{filters}}&avaliacao=pdf','','status=no, Width=1200, Height=800');">
                            <i class="ccn-flaticon-document" style="font-weight: 400;font-size: 15px;"></i> PDF
                        </button>
                        <a class="btn {{hidden}}" data-toggle="tooltip" data-placement="top" title="Imprimir Relatório em Excel" href="{{{ config.wwwroot }}}/blocks/eva_barema_afastamento/avaliacao_lista.php{{filters}}&avaliacao=xls">
                            <i class="ccn-flaticon-document" style="font-weight: 400;font-size: 15px;"></i>Excel</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</section>
<table class="table table-responsive-md table-hover text-left">
    <thead class="tableprimary">
    <tr class="text-center">
        <th style="width: 35px">#</th>
        <th>Anteprojeto</th>
        <th>Avaliador 1</th>
        <th>Avaliador 2</th>
        <th>Avaliador 3</th>
        <th>Nota Capes</th>
        <th>Nota Final</th>
        <th>Ação</th>
    </tr>
    </thead>
    <tbody>
    {{#dadosAvaliacao}}
        <tr class="text-center" style="font-size: 15px;">
            <td>{{id}}</td>
            <td>{{anteprojeto}}</td>
            <td>{{avaliador_1}}</td>
            <td>{{avaliador_2}}</td>
            <td>{{avaliador_3}}</td>
            <td>{{nota_capes}}</td>
            <td>{{nota_final}}</td>
            <td>
                <a class="" data-toggle="tooltip" data-placement="top" title="Espelho da Avaliação" href="" onclick="open('avaliacao_lista.php?anteprojeto=espelho&id={{anteprojeto}}','','status=no, Width=1000, Height=800');">
                <i class="flaticon-preview" style="font-weight: 600;font-size: 18px;"></i>
                </a>
            </td>
        </tr>
    {{/dadosAvaliacao}}
    </tbody>
    <tfoot class="bg-gray text-right pr20">
    <tr><td colspan="8"><sapn>Total de {{registros}} registros</sapn></td></tr>
    </tfoot>
</table>

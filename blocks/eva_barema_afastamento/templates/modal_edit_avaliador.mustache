<div class="avaliador_edit_modal modal fade" id="avaliador_edit_Modal" tabindex="-1" aria-labelledby="avaliador_edit_ModalLabel" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content mc-edit">
            <div class="modal-header">

                                                    </div>
                                                </div>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="{{link2}}" target="{{{link_target}}}" class="{{hiden2}}" data-toggle="{{tt2}}" data-placement="left" data-html="true" title='{{tooltip2}}'>
                                                <div class="ccn_tabs" data-ccn-c="color{{id}}" data-ccn-co="bg">
                                                    <div class="overlay">
                                                        <div class="details">
                                                            <h5 class="m0 fw600" data-ccn="" data-ccn-c="color_title{{id}}" data-ccn-co="content" style="color:#0a0a0a">{{bt2}}</h5>
                                                            <!--                                                        <h5 class="m0 fw600" data-ccn="title{{id}}" data-ccn-c="color_title{{id}}" data-ccn-co="content" style="color:#0a0a0a">{{bt2}}</h5>-->
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="{{link3}}" target="{{{link_target}}}" class="{{hiden3}}" data-toggle="{{tt3}}" data-placement="left" data-html="true" title='{{tooltip3}}'>
                                                <div class="ccn_tabs" data-ccn-c="color{{id}}" data-ccn-co="bg">
                                                    <div class="overlay">
                                                        <div class="details">
                                                            <h5 class="m0 fw600" data-ccn="" data-ccn-c="color_title{{id}}" data-ccn-co="content" style="color:#0a0a0a">{{bt3}}</h5>
                                                            <!--                                                        <h5 class="m0 fw600" data-ccn="title{{id}}" data-ccn-c="color_title{{id}}" data-ccn-co="content" style="color:#0a0a0a">{{bt3}}</h5>-->
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="{{link4}}" target="{{{link_target}}}" class="{{hiden4}}" data-toggle="{{tt4}}" data-placement="left" data-html="true" title='{{tooltip4}}'>
                                                <div class="ccn_tabs" data-ccn-c="color{{id}}" data-ccn-co="bg">
                                                    <div class="overlay">
                                                        <div class="details">
                                                            <h5 class="m0 fw600" data-ccn="" data-ccn-c="color_title{{id}}" data-ccn-co="content" style="color:#0a0a0a">{{bt4}}</h5>
                                                            <!--                                                        <h5 class="m0 fw600" data-ccn="title{{id}}" data-ccn-c="color_title{{id}}" data-ccn-co="content" style="color:#0a0a0a">{{bt4}}</h5>-->
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="{{link5}}" target="{{{link_target}}}" class="{{hiden5}}" data-toggle="{{tt5}}" data-placement="left" data-html="true" title='{{tooltip5}}'>
                                                <div class="ccn_tabs" data-ccn-c="color{{id}}" data-ccn-co="bg">
                                                    <div class="overlay">
                                                        <div class="details">

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" xmlns="http://www.w3.org/1999/html"/>
<link rel="stylesheet" href="/blocks/eva_barema_bolsa/css/admin_avaliacao.css">

<div class="{{avaliador}}">
    <h5 class="card-title text-center">Controle de avaliação Bolsas de Estudos</h5>
    <div class="section mb20">
        <div class="row">
            <div class="col-lg-12">
                <a class="btn-primary btn-thm btnAdicionarModal"
                   data-baremaid="{{baremaid}}"
                   data-root="{{{ config.wwwroot }}}"
                   href="/blocks/eva_barema_bolsa/create.php?id=1"><i class="icon fa ccn-flaticon-back fa-fw"></i>Voltar</a>
                <a class="btn-primary btn-thm btnAdicionarModal"
                   data-baremaid="{{baremaid}}"
                   data-root="{{{ config.wwwroot }}}"
                   href="/blocks/eva_barema_bolsa/avaliacao_lista.php"><i class="icon fa ccn-flaticon-list fa-fw"></i>Relatórios</a>
            </div>
        </div>
    </div>

    <table class="table table-sm table-responsive-sm table-striped table-hover text-left rtable">

        <caption style="font-size: 20px;">Controle de avaliações pendentes
            <section class="section">
                <form method="get" class="form-busca">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="form-group fg">
                                <div class="col-md-3">
                                </div>
                                <div class="col-md-9">
                                    <label>Anteprojeto</label>
                                    <select name="anteprojeto" id="id_anteprojeto" class="custom-select" style="width: 100%">
                                        <option value=""></option>
                                        {{#anteprojeto}}
                                            <option value="{{valor}}" {{selected}}>{{selecao}}</option>
                                        {{/anteprojeto}}
                                    </select>
                                </div>
                            </div>
                            <div class="form-group fg">
                                <div class="col-md-3">
                                    <label for="select2-id_avaliadores-container">Avaliador</label>
                                </div>
                                <div class="col-md-9">
                                    <select name="avaliadores" class="custom-select" style="width: 100%">
                                        <option value=""></option>
                                        {{#avaliadores}}
                                            <option value="{{valor}}" {{selected}}>{{selecao}}</option>
                                        {{/avaliadores}}
                                    </select>
                                </div>
                            </div>
                            <div class="form-group fg">
                                <div class="col-md-3">
                                    <label>Data do Envio</label>
                                </div>
                                <div class="col-md-9">
                                    <input type="date" name="data_atribuicao" id="id_data" class="custom-input" style="width: 100%">
                                </div>
                            </div>

                            <div class="form-group fg {{hidden}}">
                                <div class="col-md-3">
                                    <label>Status</label>
                                </div>
                                <div class="col-md-9">
                                    <select name="status" id="idstatus" class="custom-select" style="width: 100%">
                                        <option value=""></option>
                                        {{#status}}
                                            <option value="{{valor}}" {{selected}} >{{selecao}}</option>
                                        {{/status}}
                                    </select>
                                </div>
                            </div>
                            <input type="hidden" name="admin" value="{{iduser}}">
                            <!--                <div class="col d-flex align-items-end m_top">-->

                            <div class="d-flex align-items-center mt-4">
                                <!--                                    <div class="form-group align-items-center">-->
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-primary" name="listar">
                                        <i class="flaticon-magnifying-glass" id="yui_3_17_2_1_1647205690370_21" style="font-weight: 600;font-size: 15px;"></i>
                                    </button>
                                    <a href="{{{ config.wwwroot }}}/blocks/eva_barema_bolsa/avaliacao.php?admin={{iduser}}" class="btn btn-primary">
                                        <i class="flaticon-delete-button" id="yui_3_17_2_1_1647205690370_21" style="font-weight: 400;font-size: 15px;"></i> Limpar Filtro
                                    </a>
                                    <!--                                    <button type="submit" name="relatorio" class="btn btn-primary" href="#" onclick="open('barema_lista.php{{filters}}&relatorio=pdf','','status=no, Width=1200, Height=800');">-->
                                    <!--                                        <i class="ccn-flaticon-document" id="yui_3_17_2_1_1647205690370_21" style="font-weight: 400;font-size: 15px;"></i> PDF-->
                                    <!--                                    </button>-->
                                    <!--                                            <a class="btn btn-primary {{hidden}}" href="{{{ config.wwwroot }}}/blocks/eva_form_barema/barema_lista.php{{filters}}&relatorio=xls">Excel</a>-->
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </section>
        </caption>


        <thead class="tableprimary text-center">
        <tr>
<!--            <th>#</th>-->
            <th>Anteprojeto</th>
            <th>Avaliador</th>
            <th>Data do Envio</th>
            <th>Tempo Restante</th>
            <th>Status</th>
            <th>Ação</th>
        </tr>
        </thead>
        <tbody class="text-center">
        {{#avaliacao_bolsa}}
            <tr>
<!--                <td data-title="#">{{id}}</td>-->
                <td data-title="link">Anteprojeto {{anteprojeto}}</td>
                <td class="text-left">{{avaliador}}</td>
                <td>{{data_ini_avaliacao}}</td>
                <td>{{{timerestante}}}</td>
                <td data-title="status" class="font-weight-bold {{statuscolor}}">
                    {{status}}
                </td>
                <td class="btnbg">
                    <a class="envioEmailPendente"
                       id="id_email_pendente"
                       data-id="{{id_atribuicao}}"
                       data-tempo="{{timerestante}}"
                       data-root="{{{ config.wwwroot }}}"
                       data-toggle="modal"
                       data-target="#modalemailpendente"
                       href="#">{{{enviar_email}}}
                    </a>
                </td>
            </tr>
        {{/avaliacao_bolsa}}
        </tbody>
    </table>
<!--    page 1, {{results}} results-->

    <nav aria-label="paginacao">
        <ul class="pagination justify-content-center">
            <li class="page-item"><a class="page-link" href="{{primeiro}}" aria-label="Previous">
                <span aria-hidden="true">Primeiro</span>
            </a>
            </li>
            <!--    =============== AQUI INCLUI DUAS PAGINAS A- ANTES DO ATUAL =================-->
            {{#links_ant}}
                <li class="page-item {{select}}">
                    <a href="{{href_ant}}" class="page-link">{{pg_ant}}</a>
                </li>
            {{/links_ant}}

            <!--    =============== AQUI É A PAGINA ATUAL=================-->
            {{#links_atual}}
                <li class="page-item {{select}}">
                    <a class="page-link">{{pg_atual}}</a>
                </li>
            {{/links_atual}}

            <!--    =============== AQUI INCLUI DUAS PAGINAS A+ DEPOIS DO ATUAL =================-->
            {{#links_dep}}
                <li class="page-item {{select}}">
                    <a href="{{href_dep}}" class="page-link">{{pg_dep}}</a>
                </li>
            {{/links_dep}}
            <!--   ============== AQUI INCLUI OS PONTOS E A ULTIMA PG DEPOIS NO FINAL ============-->
            {{#links_ultimo}}
                <li class="page-item {{select}}">
                    <a href="#" class="page-link">{{pontos}}</a>
                </li>
                <li class="page-item {{select}}">
                    <a href="{{href_ultimo}}" class="page-link">{{ultima_pg}}</a>
                </li>
            {{/links_ultimo}}
            <li class="page-item">
                <a class="page-link" href="{{ultima}}" aria-label="Next">
                    <span aria-hidden="true">Última</span>
                </a>
            </li>
        </ul>
    </nav>

</div>
{{> block_eva_barema_bolsa/modal_email_pendente }}
<br>
<br>
<script type="text/javascript" src="/blocks/eva_barema_bolsa/js/modal_email_pendente.js"></script>

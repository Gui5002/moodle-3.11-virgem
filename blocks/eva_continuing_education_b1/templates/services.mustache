<link rel="stylesheet" href="{{ style }}" />
<div class="container mt70">
  <div class="row">
    <div class="col-lg-10 offset-lg-1 text-center">
      <div class="main-title text-center">
        <h1 class="mt0">{{ title }}</h1>
        <p>{{ subtitle }}</p>
      </div>
    </div>
  </div>
  <div class="container-fluid" style="background-color: {{ color }};">
    <div class="container">
      <div class="row">
        <div class="col-12">
          <section class="bg_color_principal">
            <div class="container-fluid config_boxe">
              <div class="row justify-content-center">
                <style type="text/css">
                  {
                      {
                      #info
                    }
                  }
                  .icon_hvr_img_box.ccn-box[data-ccn-c=color {
                      {
                      id
                    }
                  }
                  ]:hover {
                    background-color: {
                        {
                        body_color_hover
                      }
                    }
                    !important;
                  }
                  .icon_hvr_img_box.ccn-box[data-ccn-c=color {
                      {
                      id
                    }
                  }
                  ]:hover h5 {
                    color: {
                        {
                        title_color_hover
                      }
                    }
                    !important;
                  }
                  .icon_hvr_img_box.ccn-box[data-ccn-c=color {
                      {
                      id
                    }
                  }
                  ]:hover p {
                    color: {
                        {
                        body_color_hover
                      }
                    }
                    !important;
                  }
                  .icon_hvr_img_box.ccn-box[data-ccn-c=color {
                      {
                      id
                    }
                  }
                  ]:hover .icon span {
                    color: {
                        {
                        color_icon_hover
                      }
                    }
                    !important;
                  }
                    {
                      {
                      /info
                    }
                  }
                </style>
                {{#info}}
                <div class="col-sm-6 col-lg-3 ">
                  <a href="{{link}}" target="{{link_target}}">
                    <div class="icon_hvr_img_box ccn-box sbbg1" data-ccn-c="color{{id}}" data-ccn-co="bg"
                      style="background-color: {{body_color}};">
                      <div class="overlay">
                        <div class="ccn_icon_2 icon"><span data-ccn="icon{{id}}" data-ccn-c="color_icon{{id}}"
                            data-ccn-co="content" class="{{icon}}" style="color: {{color_icon}}"></span></div>
                        <div class="details">
                          <h5 data-ccn="title{{id}}" data-ccn-c="color_title{{id}}" data-ccn-co="content"
                            style="color: {{title_color}};color: rgb(0, 0, 0);margin-top: -10px;">{{titulo}}</h5>
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
                {{/info}}
              </div>
            </div>
            <div class="row">
              <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-12">
                <img src="{{ imgs }}" class="imgPrincipal center" alt="Main Image" />
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>
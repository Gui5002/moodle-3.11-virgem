<div class="modal-container">
    <div class="login-modal-content">
        <div class="logo-container">
            <img src="/theme/evagu/images/login/logo-esagu.png" alt="Logo">
        </div>
        <form action="{{loginurl}}" method="post" id="login">
            <br>
            <div class="heading">
                <h4 class="login_form text-center">{{#str}} login_welcome, theme_evagu {{/str}}</h4>
                {{#signup_is_enabled}}
                <p class="login_form text-center">{{#str}} login_no_account,
                    theme_evagu {{/str}}
                    <a class="text-thm" href="{{signupurl}}">{{#str}} signup, theme_evagu
                        {{/str}}</a>
                </p>
                {{/signup_is_enabled}}
            </div>
            {{#error}}
            <div class="loginerrors mt-3">
                <a href="#" id="loginerrormessage" class="accesshide">{{error}}</a>
                <div class="alert alert-danger" role="alert" data-aria-autofocus="true">{{error}}</div>
            </div>
            {{/error}}
            <input id="anchor" type="hidden" name="anchor" value>
            <script>
                document.getElementById('anchor').value = location.hash;
            </script>
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <div class="form-group">
                <label for="username" class="sr-only">
                    {{^canloginbyemail}}
                    {{#str}} username {{/str}}
                    {{/canloginbyemail}}
                    {{#canloginbyemail}}
                    {{#str}} usernameemail {{/str}}
                    {{/canloginbyemail}}
                </label>
                <br>
                <input type="text" name="username" id="username" class="form-control" value="{{username}}"
                    placeholder={{#quote}}{{^canloginbyemail}}{{#str}}username{{/str}}{{/canloginbyemail}}{{#canloginbyemail}}{{#str}}usernameemail{{/str}}{{/canloginbyemail}}{{/quote}}
                    autocomplete="username">
            </div>
            <div class="form-group">
                <label for="password" class="sr-only">{{#str}} password {{/str}}</label>
                <input type="password" name="password" id="password" value class="form-control"
                    placeholder={{#quote}}{{#str}}password{{/str}}{{/quote}} autocomplete="current-password">
            </div>
            <div class="form-group custom-control custom-checkbox">
                {{#rememberusername}}
                <input class="custom-control-input" type="checkbox" name="rememberusername1" id="rememberusername1"
                    value="1" {{#username}}checked="checked" {{/username}}>
                <label class="custom-control-label" for="rememberusername1"> {{#str}}
                    rememberusername, admin {{/str}}</label>
                {{/rememberusername}}
                <a class="tdu btn-fpswd float-right" href="{{forgotpasswordurl}}">{{#str}} forgot_password, theme_evagu
                    {{/str}}</a>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-primary" id="loginbtn">{{#str}}login{{/str}}</button>
            </div>
            <div class="separator_login">
                <span class="text">OU</span>
            </div>
        </form>
        {{#canloginasguest}}
        <div class="mt-2 text-center">
            <p>{{#str}}someallowguest{{/str}}</p>
            <form action="{{loginurl}}" method="post" id="guestlogin">
                <input type="hidden" name="logintoken" value="{{logintoken}}">
                <input type="hidden" name="username" value="guest">
                <input type="hidden" name="password" value="guest">
                <button class="btn btn-secondary" type="submit">{{#str}}loginguest{{/str}}</button>
            </form>
        </div>
        {{/canloginasguest}}
        {{#hasidentityproviders}}
        <h6 class="mt-2">{{#str}} potentialidps, auth {{/str}}</h6>
        <div class="potentialidplist" class="mt-3">
            {{#identityproviders}}
            <div class="potentialidp">
                <a href="{{url}}" title={{#quote}}{{name}}{{/quote}} class="btn btn-secondary">
                    {{#iconurl}}
                    <img src="{{iconurl}}" alt width="24" height="29" />
                    {{/iconurl}}
                    {{name}}
                </a>
            </div>
            {{/identityproviders}}
        </div>
        {{/hasidentityproviders}}
        {{#hasinstructions}}
        <div class="login_form ccn_first-time">
            <div class>
                <div class>
                    <div class>
                        <div class>
                            <h4>{{#str}}firsttime{{/str}}</h4>
                        </div>
                        <div>
                            {{{instructions}}}
                            {{#cansignup}}
                            <form class="mt-3" action="{{signupurl}}" method="get" id="signup">
                                <div class="text-center">
                                    <button type="submit" class="btn btn-secondary">{{#str}}startsignup{{/str}}</button>
                                </div>
                            </form>
                            {{/cansignup}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/hasinstructions}}
        {{#maintenance}}
        <div class="row justify-content-center mt-3">
            <div class="col-xl-6 col-sm-8">
                <div class="card">
                    <div class="card-body">
                        <div class="card-title">
                            <h2>{{#str}}sitemaintenance, core_admin{{/str}}</h2>
                        </div>
                        <div>
                            {{{maintenance}}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/maintenance}}
    </div>
</div>

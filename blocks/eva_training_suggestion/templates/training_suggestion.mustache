<style>
    .sombreamento {
        -webkit-box-shadow: 2px 3px 20px 1px rgba(0, 0, 0, 0.42);
        box-shadow: 2px 3px 20px 1px rgba(0, 0, 0, 0.42);
    }

    .row {
        margin-left: 1vw;
        margin-right: 1vw;
    }

    .jumbotron {
        background-color: rgb(239 245 255 / 33%);
        border-top: 2px solid rgb(225 230 239);
        box-shadow: 0 5px 20px 0 rgb(0 0 0 / 16%);
    }

    #ccnSearchOverlayWrap {
        display: none;
    }

    .ccnDashBlHd {
        display: none;
    }
</style>
<div id="divMsg" name="divMsg"></div>
<div class="shortcode_widget_accprdons" style="width: 100%;">
    <div>
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
            <h1 class="fontSize" data-ccn="title" style="text-align: center;">{{title}}</h1>
        </div>
    </div>
    <div>
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
            <p class="fontSize2" style="text-align: justify;" data-ccn="heading">{{heading}}</p>
        </div>
    </div>
    <br />
    <div>
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
            <h3 class="fontSize" data-ccn="subtitle">{{subtitle}}</h3>
        </div>
    </div>
    <div class="jumbotron" style="margin-left: 0px !important; margin-right: 0px !important;">
        <input type="hidden" id="ts" name="ts" value="{{ts}}">
        <input type="hidden" id="pageid" name="pageid" value="{{pageid}}">

        <div class="form-group row mb-3">
            <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0">

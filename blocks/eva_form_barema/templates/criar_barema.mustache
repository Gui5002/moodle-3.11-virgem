
<link rel="stylesheet" href="/blocks/eva_form_barema/css/form_criar_barema.css">

{{> block_eva_form_barema/customize_config}}
<div class="container-fluid">
    <div class="">
        <div class="section mb20">
            <div class="row">
                <div class="col-lg-12">
                    <a class="btn btn-primary btnConfigEdit"
                       id="id_btnConfigEdit"
                       data-root="{{{ config.wwwroot }}}"
                       data-buiedit="{{idbarema}}"
                       href="#"><i class="icon fa flaticon-settings fa-fw"></i>Novo Modelo Barema</a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="">
        <div class="row">
            <div class="col-lg-12">
                <div class="alert alert-info" role="alert">
                    <strong>Configurar Barema para Avaliação</strong>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card border">
                <div class="card-header text-center cardprimary">
                    Formulário de atribuição
                </div>
                <div class="card-body bg-light">
                    {{{formbarema}}}
                </div>
            </div>
        </div>
    </div>
</div>
<br>
<br>
<script src="https://code.jquery.com/jquery-3.6.0.js"></script>
<script src="https://code.jquery.com/ui/1.13.0/jquery-ui.js"></script>
<script src="/blocks/eva_form_barema/js/criar_barema.js"></script>
<script>
    $('.ccnDashBlHd ').addClass('d-none')
    $(document).ready(function (){
        setTimeout(function (){
            $(".notifications .alert").fadeOut("slow", function () {
                $(this).alert('close');
            });
        }, 5000);
    });
</script>



                <div class="d-flex align-items-center mt-3">
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary" name="listar">
                            <i class="flaticon-magnifying-glass" id="yui_3_17_2_1_1647205690370_21"
                                style="font-weight: 600;font-size: 15px;"></i>
                        </button>
                        <a href="{{{ config.wwwroot }}}/blocks/eva_form_barema/barema_lista.php"

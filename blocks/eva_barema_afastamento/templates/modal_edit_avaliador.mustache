                                </select>
                            </div>
                        </div>
                        <div id="bitem_id_eixojuridico" class="form-group row bitem">
                            <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0">
                                <label class="d-inline word-break ">Distribuição</label>
                            </div>
                            <div class="col-md-4 form-inline align-items-start felement">

{{! <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" xmlns="http://www.w3.org/1999/html"/> }}

<style>
    .avaliador_bolsa_modal:before {
        background-color: rgba(0,0,0,.9);
        bottom: 0;
        content: "";
        left: 0;
        position: absolute;
        right: 0;
        top: 0;
    }

    .avaliador_bolsa_modal .modal-dialog .modal-content{
        border-radius: 5px;
        padding: 0px;
        width: 50%;
        margin: 13% auto;
    }
    .avaliador_bolsa_modal .modal-dialog .modal-content .modal-header{
        padding: 15px;
    }

    .select2-container .select2-selection--single {
        height: 38px;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 38px;
        font-size: 14px;
    }
    .select2-container--default .select2-results>.select2-results__options {
        font-size: 13px;
    }



</style>


<div class="avaliador_bolsa_modal modal fade" id="avaliador_bolsa_Modal" tabindex="-1" aria-labelledby="avaliador_bolsa_ModalLabel" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="avaliador_bolsa_ModalLabel"></h5>
                <button type="button" class="btn-close modalClose" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                    <input type="hidden" name="editavaliador_afast" id="id_edit_avaliador_afast" value="">
                    <div class="fcontainer clearfix m_area">
                        <div id="bitem_id_titular_user_id" class="form-group row bitem">
                            <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0">
                                <label class="d-inline word-break " for="id_titular_user_id">Avaliador</label>
                                <div class="form-label-addon d-flex align-items-center align-self-start">
                                    <div class="text-danger" title="Necessários">
                                        <i class="icon fa ccn-flaticon-warning text-danger fa-fw " title="Necessários"
                                           aria-label="Necessários"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-9 form-inline align-items-start felement" data-fieldtype="select">
                                <select class="custom-select selecttitular titular_user_id" style="width: 100%" name="titular_user_id" id="user_id" data-root=" {{{config.wwwroot}}}">
                                </select>
                            </div>
                        </div>

                        <div id="bitem_id_eixojuridico" class="form-group row bitem">
                            <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0">
                                <label class="d-inline word-break ">Distribuição</label>
                                <div class="form-label-addon d-flex align-items-center align-self-start">
                                    <div class="text-danger" title="Necessários">
                                        <i class="icon fa ccn-flaticon-warning text-danger fa-fw " title="Necessários"
                                           aria-label="Necessários"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 form-inline align-items-start felement">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" value="j" id="juridico" name="distribuicao">
                                    <label class="form-check-label fontSize2" for="juridico">Eixo Jurídico</label>
                                </div>
                                <input type="hidden" class="form-control distribuicao">
                                <div class="form-control-feedback invalid-feedback">- Escolha uma distribuição</div>
                            </div>
                            <div class="col-md-4 form-inline align-items-start felement">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" value="g" id="tecnico" name="distribuicao">
                                    <label class="form-check-label fontSize2" for="tecnico">Eixo Governança e Gestão</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer eventButton">
                        <button type="button" class="btn btn-secondary modalFechar" data-dismiss="modal">Fechar</button>
                        <button type="button" name="editarbutton_avaliador" id="id_Adicionar" class="btn btn-primary btnEvento" data-root="{{{ config.wwwroot }}}" onclick="add_alter_avaliador_bolsa(this)">Adicionar</button>
                    </div>
<!--                </form>-->
            </div>
        </div>
    </div>
</div>

    * {
        font-size: 1rem;
        font-family: '[[setting:primary_font]]', helvetica, arial, sans-serif;
    }

    .table {
        width: 100%;
        margin-bottom: 1rem;
        background-color: transparent;
    }

    .table-bordered {
        border: 1px solid #dedede;
        width: 100%;
    }

    .table-bordered th,
    td {
        border: 1px solid #dee2e6 !important;
    }

    .text-center {
        text-align: center !important;
    }

    .table td,
    .table th {
        padding: .75rem;
        vertical-align: top;
        border-top: 1px solid #dee2e6;
    }

    .table {
        border-collapse: collapse;
    }

    .rtable tbody tr td {
        position: relative;
    }

    .rtable thead {
        display: none;
    }

    .rtable tbody td {
        display: flex;
        flex-direction: column;
    }

    .rtable tbody tr td {
        /*display: block;*/
        text-align: right;
    }

    .rtable tbody tr {
        margin-bottom: 10px;
        display: block;
    }

    .rtable tbody tr td:before {
        width: 30%;
        content: attr(data-title);
        text-align: left;
        display: block;
        position: absolute;
        background-color: #0c3551;
        top: 0;
        left: 0;
        height: 25px;
        padding: 9px 14px;
        color: #FFFFFF;
        font-weight: 400;
    }

    .rtable tbody tr .btnbg:before {
        display: none;
    }

    .table>:not(caption)>*>* {
        padding: 0.9rem 0.5rem;
        border-bottom-width: 1px;
    }

    .custom-radio {
        float: right;
    }

    .ntable thead tr,
    table tfoot tr {
        text-align: center;
        background-color: #656b6c;
        color: #fff0f0;
    }

    .ntable tbody tr td {
        vertical-align: middle;
        background-color: #ffffff;
    }

    .unlist {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .ntable .th1 {
        width: 10px;
    }

    .ntable .th2 {
        width: 200px;
    }

    /*.ntable .th3{width: 50px; }*/
    .ntable .th4 {
        width: 200px;

<link rel="stylesheet" href="/blocks/eva_form_barema/css/form_avaliar_barema.css">


    {{> block_eva_form_barema/customize_config}}
<form autocomplete="off" action="{{{ config.wwwroot }}}/blocks/eva_form_barema/barema_avaliacao.php?barema_id={{id_barema}}&avaliador_id={{id_avaliador}}&curso_id={{id_curso}}&quiz_id={{id_quiz}}&aluno_id={{id_aluno}}&tb_id_avaliador={{id_tb_avaliador}}" method="post"
    accept-charset="utf-8" id="mform1" class="{{esconderavaliacao}}" data-boost-form-errors-enhanced="1">
    <input type="hidden" name="avaliador_tb_user_id" value="{{id_avaliador}}">
    <input type="hidden" id="idbarema" name="tb_barema_id" value="{{id_barema}}">
    <input type="hidden" id="id_wwwroot" value="{{{ config.wwwroot }}}">
    <input type="hidden" name="percent" value="{{percent}}">

        <!--========================================== VISUALIZAÇÃO DA ATIVIDADE OU RECURSO ================================================ -->

<!--        <div class="card border w-100">-->
<!--            <div class="card-body">-->
<!--                <h5 class="card-title">{{alunos}}</h5>-->
<!--                <p class="card-text">Curso : {{curso}}</p>-->
<!--            </div>-->
<!--        </div>-->
        <div class="fcontainer clearfix bg_area">

            <div id="bitem_id_aluno" class="form-group row bitem ">
                <div class="col-md-9 form-inline align-items-start felement px-0">
                    <input type="hidden" class="form-control aluno_id "
                           name="aluno"
                           data-avaliador_id="{{id_avaliador}}"
                           data-curso_id="{{id_curso}}"
                           data-quiz_id="{{id_quiz}}"
                           placeholder="Buscar aluno inscrito"
                           value="" aria-invalid="false">
                    <div id="alunos_list" class="position-absolute z-index-1 lista"></div>

<!--                    <div class="form-control-feedback invalid-feedback" id="id_error_aluno"> - {{#str}}missingaluno, block_eva_form_barema{{/str}}</div>-->
                </div>
            </div>

            <input type="hidden" id="id_estudante" name="aluno_tb_user_id" value="{{id_aluno}}">
            <input type="hidden" id="id_tb_avaliador" name="tb_avaliador_id" value="{{id_tb_avaliador}}">

            <div class="avaliacao">
                <img src="{{config.wwwroot}}/user/pix.php/2/f1.jpg" alt="Escola Vitual da Agu"/>
                <div class="avaliacao-content">
                    <div class="avaliacao-content-header">
                        <strong>Escola Vitual da Agu </strong>
                        <span>eva@agu.gov.br</span>
                    </div>
                    <span><strong>Curso:</strong> {{curso}}</span>

                    <span>{{{resposta_question}}}</span>
                    <span>{{{resp_correta}}}</span>
                </div>
            </div>

            <div class="avaliacao" style="margin-left: 6rem ">
                <img src="{{config.wwwroot}}/blocks/eva_form_barema/imgens/png/profile.png" alt="Professor"/>
                <div class="avaliacao-content">
                    <div class="avaliacao-content-header">
                        <strong>{{alunos}}</strong>
                        <span>{{email}}</span>
                    </div>
                    <span><strong>Curso:</strong> {{curso}}</span>
                    <span>{{{resp_resposta}}}</span>
                </div>
            </div>

        </div>
<!--    </fieldset>-->

<!--    <fieldset class="clearfix collapsible " id="id_analiserandpass">-->
<!--        <div class="bg_btoggle">-->
<!--            <legend class="btoggler">-->
<!--                <a href="javascript:void(0)" class="fheader" id="id_analise_pass" role="button" aria-controls="id_analiserandpass" aria-expanded="true">{{#str}}analiserandpass, block_eva_form_barema{{/str}}</a>-->
<!--            </legend>-->
<!--        </div>-->

        <div class="fcontainer clearfix bg_area">
                <div class="col-md-12">
<!--                    <table class="table table-bordered table-responsive-sm table-hover rtable">-->
                    <table class="table table-bordered table-sm table-striped table-responsive-sm table-hover rtable">
                        <thead class="tableprimary">
                        <tr>
                            <th class="text-center" style="width: 3%">Id</th>
                            <th>Critério</th>
                            <th style="width: 20%">Nota Maxima</th>
                            <th style="width: 18rem">Faixa</th>
                            <th class="text-center" style="width: 5%">Nota</th>
                        </tr>
                        </thead>
                        <tbody>

                        {{#barema}}
                            <tr>
                                <td data-title="#" class="text-center">{{id}}</td>
                                <td data-title="Critério">{{criterio}}</td>
                                <td data-title="Nota_Maxima">{{nota_maxima}}</td>
                                <td data-title="Faixa">
                                    <ul class="unlist">
                                        <li>
                                            <label {{hidden_baixa}} for="id_f1{{id}}">{{label_baixa}}</label>
                                            <input {{hidden_baixa}} class="custom-radio" type="radio" id="id_f1{{id}}" name="nt_faixa_{{id}}" value="{{valor_baixa}}">
                                        </li>
                                        <li>
                                            <label {{hidden_media1}} for="id_f2{{id}}">{{label_media1}}</label>
                                            <input {{hidden_media1}} class="custom-radio" type="radio" id="id_f2{{id}}" name="nt_faixa_{{id}}" value="{{valor_media1}}">
                                        </li>
                                        <li>
                                            <label {{hidden_media2}} for="id_f3{{id}}">{{label_media2}}</label>
                                            <input {{hidden_media2}} class="custom-radio" type="radio" id="id_f3{{id}}" name="nt_faixa_{{id}}" value="{{valor_media2}}">
                                        </li>
                                        <li>
                                            <label {{hidden_media3}} for="id_f4{{id}}">{{label_media3}}</label>
                                            <input {{hidden_media3}} class="custom-radio" type="radio" id="id_f4{{id}}" name="nt_faixa_{{id}}" value="{{valor_media3}}">
                                        </li>
                                        <li>
                                            <label {{hidden_alta}} for="id_f5{{id}}">{{label_alta}}</label>
                                            <input {{hidden_alta}} class="custom-radio" type="radio" id="id_f5{{id}}" name="nt_faixa_{{id}}" value="{{valor_alta}}">
                                        </li>
                                    </ul>
                                </td>
                                <td data-title="Nota" class="text-center" id="id_nota{{id}}" style="font-size: 19px;">0</td>
                            </tr>
                        {{/barema}}
                        </tbody>
                        <tfoot>
                        <tr class="{{display}}">
                            <td colspan="4" class="fw500 text-right text-danger">Aluno(a) respondeu fora do prazo a nota será reduzida em 10% ! </td>
                            <td hidden id="id_desconto" class="fw600 text-center" style="font-size: 19px;">{{percent}}</td>

                        </tr>
                        <tr>
                            <td colspan="4" class="fw600 text-right">NOTA FINAL</td>
                            <td id="id_nota_final" class="fw600 text-center" style="font-size: 19px;"></td>

                        </tr>
                        </tfoot>
                    </table>
                    <div>
                        <input type="hidden" id="nota_final" name="nt_avaliador">
                        <div class="hidden" id="id_qtd">{{items}}</div>
                    </div>
                </div>
        </div>

<!--    <div id="fgroup_id_buttonar" class="form-group row  bitem">-->
<!--        <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0">-->
<!--            <div class="form-label-addon d-flex align-items-center align-self-start"></div>-->
<!--        </div>-->
<!--        <div class="col-md-9 form-inline align-items-start felement">-->

<!--        </div>-->
<!--    </div>-->
    <div class="fcontainer row text-center">
        <div class="col-md-12">
            <div class="form-group  bitem">
                <input type="submit" class="btn btn-primary btn-none d-none" name="submitbutton" id="id_submitbutton" value="{{#str}}submitbarema, block_eva_form_barema{{/str}}">
                <input type="submit" class="btn btn-secondary " name="cancelbutton" id="id_cancel" value="{{#str}}cancelatbarema, block_eva_form_barema{{/str}}" data-skip-validation="1" data-cancel="1"
                       onclick="skipClientValidation = true; return true;">
            </div>
            <div class="fdescription required">
                Este formulário contém campos obrigatórios marcados com
                <i class="icon fa ccn-flaticon-warning text-danger fa-fw " title="Campo obrigatório" aria-label="Campo obrigatório">
                </i>.
            </div>
        </div>
    </div>
</form>

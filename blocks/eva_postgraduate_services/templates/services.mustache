<link rel="stylesheet" href="/blocks/eva_postgraduate_services/services.css" />
<div class="container-fluid cor_fundo">
  <div class="container">
    <div class="row justify-content-end">
      <div class="col-12">
        <div
          class="fundo_img"
          data-ccn-c="color"
          data-ccn-co="bg"
          style="background-color:{{{color_retangle}}}"
        ></div>
        <img
          data-ccn="image"
          data-ccn-img="src"
          class="img-fluid section_img"
          src="{{ imgs }}"
        />
      </div>
      <div class="row section_nav">
        <div class="col-12">
          <div
            id="our-courses"
            data-ccn-c="color_bg"
            data-ccn-cv="{{{color_bg}}}"
          >
            <div class="row justify-content-end">
              {{#info}}
              <style type="text/css">
                .icon_hvr_img_box.ccn_s[data-ccn-c=color{{id}}]:hover {
                    background-color:{{color_hover}}!important;}
                .icon_hvr_img_box.ccn_s[data-ccn-c=color{{id}}]:hover h5 {
                                                                color:{{title_color_hover}}!important;}
                .icon_hvr_img_box.ccn_s[data-ccn-c=color{{id}}]:hover p {
                                                                color:{{body_color_hover}}!important;}
                .icon_hvr_img_box.ccn_s[data-ccn-c=color{{id}}]:hover .icon span {
                                                                color:{{icon_color_hover}}!important;}
              </style>
              <div class="col-sm-6 col-md-6 col-lg-3">
                <a href="{{ link }}" target="{{{link_target}}}">
                  <div
                    class="icon_hvr_img_box ccn-box ccn_s"
                    data-ccn-c="color{{ id }}"
                    data-ccn-co="bg"
                    style="background-color:{{{color}}}"
                  >
                    <div class="overlay">
                      <div class="ccn_icon_2 icon">
                        <span
                          data-ccn="icon{{ id }}"
                          data-ccn-c="color_icon{{ id }}"
                          data-ccn-co="content"
                          class="icon_bg {{{icon}}}"
                          style="color:{{{icon_color}}}"
                        ></span>
                      </div>
                      <br />
                      <div class="details">
                        <h5
                          data-ccn="title{{ id }}"
                          data-ccn-c="color_title{{ id }}"
                          data-ccn-co="content"
                          style="color:{{{title_color}}}"
                        >
                          {{ titulo }}
                        </h5>
                        <p
                          data-ccn="body{{ id }}"
                          data-ccn-c="color_body{{ id }}"
                          data-ccn-co="content"
                          style="color:{{{body_color}}}"
                        >
                          {{ body }}
                        </p>
                      </div>
                    </div>
                  </div>
                </a>
              </div>
              {{/info}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

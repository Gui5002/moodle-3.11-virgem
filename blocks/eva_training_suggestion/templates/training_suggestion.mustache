                    Cargo :
                    <i class="icon fa ccn-flaticon-info text-info fa-fw " title="Selecione o Cargo."
                        aria-label="Necessários"></i>
                </label>

                <div class="form-label-addon d-flex align-items-center align-self-start">
                    <div class="text-danger" title="Necessários">
                        <i class="icon fa ccn-flaticon-warning text-danger fa-fw " title="Obrigatório"
                            aria-label="Necessários"></i>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-9 col-lg-9 col-xl-9">
                <select data-ccn="select1" class="form-control" id="eva_slc_cargo" name="eva_slc_cargo">
                    <option value="">&nbsp;</option>
                    {{#for_op}}
                    <option value="{{valor}}" {{selected_cargo}}>{{cargo}}</option>
                    {{/for_op}}
                </select>
                <div class="form-control-feedback invalid-feedback"> - O Campo cargo esta vazio.</div>
            </div>
        </div>
        <div class="row form-group mb-3">
            <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0">

<link rel="stylesheet" href="{{styleb3}}">
<div class="container-fluid">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <section style="padding-bottom: 0px !important;">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5 col-xl-5 col-xxl-5 divPrincipalb3_left">
                            <h1 class="tituloPrincipalb3" style="color: {{title_color}};">{{title}}</h1>
                            <h3 class="subtituloPrincipalb3" style="color: rgb(87, 85, 85);">{{subtitle}}</h3>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7 col-xl-7 col-xxl-7 divPrincipalb3_right">
                            <blockquote class="blockquotebarb3" style="color: {{text_color}};">
                                {{text}}
                            </blockquote>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid" style="background-color: {{color}};">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <style>
                    .cardDivPrincipal {
                        color: {
                            {
                                cards_color
                            }
                        }
                        ;
                    }
                    
                    #itemLinkPrincipal:hover>span {
                        color: {
                            {
                                cards_color_hover
                            }
                        }
                        ;
                    }
                </style>
                <section style="padding-bottom: 0px;">
                    <div class="row">
                        {{#info}}
                        <div class="col-xs-12 col-sm-12 col-md-6 setMargins_bottom">
                            <a href="{{item_link}}" id="itemLinkPrincipal">
                                <span class="{{item_icon}} cardDivPrincipal"></span>
                                <h3 style="color: {{cards_text_color}};">{{item_titulo}}</h3>
                                <p style="color: {{cards_text_color}};">{{item_subtitle}}</p>
                                <p style="margin-right: 1%; color: {{cards_text_color}};">{{item_body}}</p>
                            </a>
                        </div>
                        {{/info}}
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
                                </div>
                                <div class="col-sm-12 col-lg-6">
                                    <p class="text-justify" data-ccn="" data-ccn-c="color_body{{id}}" data-ccn-co="content">{{{info_body}}}</p>
                                    <!--                                <p class="text-justify" data-ccn="body{{id}}" data-ccn-c="color_body{{id}}" data-ccn-co="content">{{{info_body}}}</p>-->
                                </div>
                                <div class="col-sm-12 col-lg-3">
                                    <ul class="button_tabs no-list-style">
                                        <li>
                                            <a href="{{link1}}" target="{{{link_target}}}" class="{{hiden1}}" data-toggle="{{tt1}}" data-placement="left" data-html="true" title='{{tooltip1}}'>

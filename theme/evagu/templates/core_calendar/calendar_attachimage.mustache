{{!
    @template core_calendar/calendar_attachimage

    Calendar view to show the attach image.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Example context (json):
    {
        
    }
}}
<div>
    <br/>
    <div class="thumb" id="calendar-attachimage-{{uniqid}}">
        <div class=".gallery_item">  
            <div class="gallery_overlay" data-ccn-c="color_overlay" data-ccn-co="ccnBg" data-ccn-cv="">
                <a class="popup-img popup-youtube home_post_overlay_icon bgc-theme8" href="{{urlyou}}" style="top: 120px;">
                    <div class="video_popup_btn"><span class="flaticon-play-button-1"></span></div>
                </a>
                <img id="calendar-attachimage-{{uniqid}}" class="img-fluid" src="{{eventimage}}" style="width: 247px; height: 247px; max-width: 247px; max-height: 247px; min-width: 247px; min-height: 247px;">
            </div>
        </div>
    </div>
</div>
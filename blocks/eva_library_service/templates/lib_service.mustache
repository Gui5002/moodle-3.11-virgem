                                                    </div>
                                                </div>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    {{/info}}
                    <div class="tab-pane fade show bg-white" id="pills-contact" role="tabpanel" aria-labelledby="pills-contact-tab">
                        <div class="row p25">
                            <!--                            <div class="col-sm-12 col-lg-3">-->
                            <!--                                <img data-ccn="image" data-ccn-img="src" class="img-fluid tabs_img" src="{{image}}">-->
                            <!--                            </div>-->
                            <div class="col-sm-12 col-lg-12">
                                <div class="text-center">
                                    <span class="font-weight-normal" style="font-size: 22px;">Entre em contato com a Biblioteca da AGU para dúvidas, sugestões e reclamações.</span>
                                </div>
                                <form action="{{{config.wwwroot}}}/local/contact/index.php" method="post" class="pt30 lib-service">
<!--                                <form action="{{{config.wwwroot}}}/mod/page/view.php?id=7" method="post" class="pt30 lib-service">-->

                                    <input type="hidden" name="solicitante">
                                    <input type="hidden" name="name" value="{{name}}">
                                    <input type="hidden" name="email" value="{{email}}">
                                    <div class="row contact_pg">
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <label for="name" id="namelabel">{{#str}}your_name, block_eva_library_service{{/str}}</label>
                                                <input class="form-control" id="name" name="nome_do_solicitante" type="text" title="{{#str}}your_name_requirements, theme_evagu{{/str}}" required="required" value="">
                                            </div>

                                            <div class="form-group">
                                                <label for="email" id="emaillabel">{{#str}}email_address, block_eva_library_service{{/str}}</label>
                                                <input class="form-control" id="email" name="email_do_solicitante" type="email" required="required" title="{{#str}}email_address_requirements, theme_evagu{{/str}}" value="">
                                                <input type="hidden" name="nome_do_destinatario">
                                            </div>
                                            <div class="form-group">
                                                <label for="message" id="messagelabel">{{#str}}to, block_eva_library_service{{/str}}</label>
                                                <select class="form-control" name="biblioteca" id="id_biblioteca">
                                                    <option value="">---Enviar Para---</option>
                                                    {{#options}}
                                                        <option value="{{e_mail}}">{{destino}}</option>
                                                    {{/options}}
                                                </select>
                                            </div>

                                        </div>
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <label for="message" id="messagelabel">{{#str}}message, block_eva_library_service{{/str}}</label>
                                                <textarea class="form-control" id="message" name="message" rows="6" title="{{#str}}message_requirements, theme_evagu{{/str}}" required="required"></textarea>
                                            </div>
                                            <div class="form-group text-center">
                                                <input type="hidden" id="sesskey" name="sesskey" value="">
                                                <script>
                                                    document.getElementById('sesskey').value = M.cfg.sesskey;
                                                </script>
                                                <a class="mt40 mb20 btn btn-danger {{hiden}}" href="{{{config.wwwroot}}}/admin/settings.php?section=manageauths"><i class="fa fa-warning"></i> Configure reCAPTCHA keys</a>
                                            </div>

                                            <div class="form-group text-center mt50 mb0">
                                                <button type="submit" name="submit" value="biblioteca" id="submit" class="btn dbxshad btn-lg btn-thm2 rounded w-60">{{#str}}send, block_eva_library_service{{/str}}</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

